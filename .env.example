# SQLite (default) — relative path resolved from project if left default in config
# DATABASE_URL=sqlite:///./data/vapt.db

# Postgres later:
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/vapt

# Evidence storage directory (default: <project>/data/evidence)
# EVIDENCE_DIR=/absolute/path/to/evidence

# Feature-flagged Laya triage (default false — rules fallback only)
LAYA_ENABLED=false
# Optional remote override (tried first when reachable)
LAYA_SERVICE_URL=http://127.0.0.1:8090
# Local SDK checkpoint (typed-decisions = 1024 token budget)
LAYA_REPO=convaiinnovations/laya
LAYA_SUBFOLDER=typed-decisions
LAYA_DEVICE=auto
LAYA_PRELOAD=false
LAYA_MODEL_VERSION=laya-typed-decisions
# Last-resort deterministic stub only (real SDK preferred)
LAYA_USE_STUB=false
# Optional: path to a fine-tuned checkpoint directory (laya.Agent(path))
# When set, overrides LAYA_REPO/LAYA_SUBFOLDER for local inference.
# LAYA_LOCAL_CHECKPOINT=<repo-root>/data/finetune/runs/<run_id>/checkpoint
RULES_MODEL_VERSION=rules-v1

# If transformers hangs on import: USE_TF=0
# USE_TF=0

# First-cut auth (API key / session + engagement ACLs). Default off.
AUTH_ENABLED=false
# Raw admin API key seeded on startup when AUTH_ENABLED=true (min ~16 chars).
# BOOTSTRAP_API_KEY=change-me-long-random-admin-key
# HMAC secret for signed session cookies
# SESSION_SECRET=change-me-long-random-session-secret

# Fail-closed extras (see README auth section)
# ALLOW_INSECURE_OPEN_MODE=false
# EXPOSE_API_DOCS=false
# SESSION_COOKIE_SECURE=false
# MAX_UPLOAD_BYTES=33554432

# Optional API-key HMAC pepper (defaults to SESSION_SECRET)
# API_KEY_PEPPER=
